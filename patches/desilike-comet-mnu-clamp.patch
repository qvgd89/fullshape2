         comet_cosmo[comet_name] = cosmo[name]
     comet_cosmo['As'] *= 1e9  # comet uses As in units of 1e-9
+    if xp is not None:
+        comet_cosmo['Mnu'] = xp.maximum(comet_cosmo['Mnu'], 0.)
     return comet_cosmo
 
 
